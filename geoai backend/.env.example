# GeoAI / SatQuery backend environment
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`. Values below are placeholders only.

# ---------------------------------------------------------------
# Environment
# ---------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
DEBUG=false                        # true only for local development

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------
# Minimum 32 characters, random. The app REFUSES to start with a
# weak/default JWT_SECRET except when ENVIRONMENT=development AND
# DEBUG=true.
JWT_SECRET=replace-with-64-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ---------------------------------------------------------------
# DATABASE_URL is the single source of truth for the application.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
# POSTGRES_* are consumed by docker-compose only, and must match
# the credentials inside DATABASE_URL.
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DBNAME

# ---------------------------------------------------------------
# LLM (Groq — OpenAI-compatible endpoint)
# ---------------------------------------------------------------
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------
# OpenWeather
# ---------------------------------------------------------------
OPENWEATHER_API_KEY=

# ---------------------------------------------------------------
# Optional S3-compatible storage (MinIO / AWS S3)
# ---------------------------------------------------------------
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=geoai
S3_REGION=auto
MAX_UPLOAD_MB=100

# ---------------------------------------------------------------
# App defaults
# ---------------------------------------------------------------
API_PORT=8000
SESSION_MAX_AGE_MS=28800000
DEMO_PASSWORD=geoai-demo
VITE_IDLE_TIMEOUT_MS=300000
GEOAI_DEFAULT_LAT=28.6139
GEOAI_DEFAULT_LON=77.2090
GEOAI_DEFAULT_RADIUS_METERS=1000
GEOAI_DEFAULT_ELEVATION_M=35
GEOAI_DEFAULT_RIVER_DISTANCE_KM=1.0